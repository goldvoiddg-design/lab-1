# 1. Ігнорувати всі файли .a
*.a

# 2. Але відстежувати lib.a
!lib.a

# 3. Ігнорувати TODO тільки в поточній папці
/TODO

# 4. Ігнорувати папку build
build/

# 5. Ігнорувати doc/notes.txt, але не doc/server/arch.txt
doc/*.txt

# 6. Ігнорувати PDF у папці doc/ та підпапках
doc/**/*.pdf

# 7. Ігнорувати логи
*.log

# 8. Ігнорувати кеш Python
__pycache__/

# 9. Ігнорувати системні файли macOS
.DS_Store

# 10. Ігнорувати файли з секретами (паролі, ключі)
.env